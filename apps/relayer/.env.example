# Copy to apps/relayer/.env — all values optional.

# Helius RPC key. If set, RPC = https://{network}.helius-rpc.com/?api-key=KEY
# otherwise the public https://api.devnet.solana.com is used. Never logged.
HELIUS_API_KEY=

# devnet | mainnet (default devnet). Devnet tries a one-time 1 SOL airdrop if the relayer balance is 0.
SOLANA_NETWORK=devnet

# solana-keygen style JSON (array of 64 bytes). Relative paths resolve from the repo root.
# Generated automatically on first start if missing (gitignored). Fund it from the treasury
# 6T9AvUXqBnSrSxwdLmUnxttgdkSqyWDUQUcYqZf7mkpv; >= 0.001 SOL switches the relayer to "onchain" mode.
RELAYER_KEYPAIR_PATH=apps/relayer/.relayer-keypair.json

# HTTP port (default 8787)
PORT=8787

# Max message envelopes per minute per IP (default 120; long texts are chunked into many envelopes).
MESSAGE_RATE_PER_MIN=120

# Max messages accepted per UTC day (fee budget guard). Excess requests get 503.
DAILY_MESSAGE_CAP=5000

# Set to 1 to never touch the network (always "local" mode) — used by tests.
# RELAYER_OFFLINE=0
